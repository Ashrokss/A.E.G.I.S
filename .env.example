# AEGIS local configuration. Copy to .env (gitignored).
# In AWS these come from the ECS task definition + Secrets Manager instead.
# Values for the Cognito block: `terraform output -raw env` in infra/terraform/environments/local
# (a local-only pool), or `terraform output cognito` in environments/prod.

# ── Cognito (authentication) ────────────────────────────────────────────────
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
# ABSOLUTE hosted-UI URL, e.g. https://aegis-123456789012.auth.us-east-1.amazoncognito.com
AWS_COGNITO_DOMAIN=
AWS_COGNITO_ISSUER_URL=
AWS_COGNITO_JWKS_URL=

# ── PostgreSQL (authorization: users, AWS accounts, integrations) ───────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-locally
POSTGRES_SSL=

# ── Sealing keys (32 bytes, hex): openssl rand -hex 32 ──────────────────────
AWS_ONBOARDING_ENC_KEY=
INTEGRATIONS_ENC_KEY=

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Local dev: your own profile (mounted read-only into the containers) is used
# for Bedrock and for assuming AegisProvisioner roles. Terraform NEVER sees it.
AWS_PROFILE=default
# The principal your local AegisProvisioner stack trusts (your IAM user/role
# ARN locally; the ECS task role in AWS). Pre-fills the onboarding link.
AEGIS_TASK_ROLE_ARN=
# `terraform output provisioner_template_url`
AWS_ONBOARDING_TEMPLATE_URL=

# ── Bedrock (blank model ids = mock mode) ───────────────────────────────────
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=
BEDROCK_MODEL_CHAT=
BEDROCK_MODEL_CODEGEN=
BEDROCK_MODEL_HEAVY=
BEDROCK_EMBED_MODEL=
BEDROCK_EMBED_DIMENSIONS=1024
MODEL_MAX_OUTPUT_TOKENS=8192

# ── Agent ───────────────────────────────────────────────────────────────────
MANDATORY_DOC_FETCH_STRICT=true
# Terraform doc search + knowledge-base web research (optional; free tier works)
TAVILY_API_KEY=

# ── Operator Jira intake (optional; off by default) ─────────────────────────
JIRA_POLL_SECONDS=0
JIRA_AUTO_LABEL=aegis-auto
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
