# A NEW private instance, not an import of the existing public
# aegis-auth. Three reasons, all of them things a plan would happily do
# and you would only notice afterwards:
#
#   1. The existing instance is publicly reachable. Flipping publicly_accessible
#      AND db_subnet_group_name in place is a large, partly-destructive change
#      with a real chance of a multi-minute outage and an unreachable endpoint.
#   2. Terraform cannot read `password` back, so an import needs
#      ignore_changes = [password] forever -- or the first apply resets the
#      master password and locks the backend out of its authorization store,
#      which locks out every user.
#   3. manage_master_user_password (RDS-managed rotation into Secrets Manager)
#      cannot be retrofitted onto an import without a password change anyway.
#
# Cutover is a pg_dump/pg_restore of one small schema (users,
# schema_migrations) -- or just letting backend/src/db/migrate.js build it
# fresh and re-running the bootstrap admin. See README.md. Freeze admin-user
# creation during the window: an admin created against the old instance
# vanishes at cutover.

resource "aws_db_subnet_group" "main" {
  name       = "${var.name}-data"
  subnet_ids = var.data_subnet_ids

  tags = { Name = "dbsg-${var.name}" }
}

resource "aws_db_parameter_group" "main" {
  name   = "${var.name}-pg16"
  family = "postgres${var.engine_version}"

  # The app connects with POSTGRES_SSL=true and verifies the RDS CA. Requiring
  # TLS server-side means a misconfigured client fails loudly at connect rather
  # than silently sending credentials in the clear.
  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_db_instance" "main" {
  identifier     = "${var.name}-auth"
  engine         = "postgres"
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage     = var.allocated_storage
  max_allocated_storage = var.max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.username
  # Generated by RDS, rotated by RDS, never seen by Terraform and never in
  # state. The container reads it from the secret ARN this exposes.
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [var.db_security_group_id]
  parameter_group_name   = aws_db_parameter_group.main.name
  publicly_accessible    = false
  multi_az               = var.multi_az

  backup_retention_period = var.backup_retention_days
  backup_window           = "03:00-04:00"
  maintenance_window      = "sun:04:30-sun:05:30"
  copy_tags_to_snapshot   = true

  # Losing this locks every user out of the product -- users.role is the only
  # source of an application role.
  deletion_protection       = var.deletion_protection
  skip_final_snapshot       = false
  final_snapshot_identifier = "${var.name}-auth-final"

  performance_insights_enabled    = true
  enabled_cloudwatch_logs_exports = ["postgresql"]
  auto_minor_version_upgrade      = true

  tags = { Name = "rds-${var.name}-auth" }
}
